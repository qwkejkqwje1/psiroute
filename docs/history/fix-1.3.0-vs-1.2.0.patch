+// guiHTTP is shared by every API call of the window. Up to 1.2.0 each call
+// built its own http.Client + http.Transport. Such a transport keeps its
+// keep-alive connection forever (IdleConnTimeout = 0), so every poll (each
+// 1.2 s) left one idle TCP connection with two goroutines and read/write
+// buffers in the window process plus a serving goroutine in the core. Over a
+// few hours that is thousands of connections: the steady RAM growth.
+var guiHTTP = &http.Client{Timeout: 25 * time.Second, Transport: &http.Transport{
+	Proxy:               nil,
+	MaxIdleConns:        2,
+	MaxIdleConnsPerHost: 2,
+	IdleConnTimeout:     30 * time.Second,
+	DisableCompression:  true,
+}}
