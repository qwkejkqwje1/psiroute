+	case "vio":
+		return ui.pal.vioSoft, ui.pal.vio, tint(ui.pal.vio, 70), ui.pal.vio
+	case "teal":
+		return ui.pal.tealSoft, ui.pal.teal, tint(ui.pal.teal, 70), ui.pal.teal
+	}
+	return ui.pal.card2, ui.pal.text, ui.pal.border, ui.pal.acc
