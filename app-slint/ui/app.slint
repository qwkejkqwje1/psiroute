import { ListView, ScrollView } from "std-widgets.slint";

export struct RegionRow {
    code: string,
    label: string,
    fav: bool,
}

export struct RuleRow {
    name: string,
    target: string,
    action: string,
}

export global Logic {
    in-out property <int> page: 0; // 0 главный, 1 страны, 2 маршруты, 3 лента, 4 настройки
    in property <bool> connected: false;
    in property <bool> connecting: false;
    in property <string> status-text: "Отключено";
    in property <string> region-label: "Страна: авто";
    in property <string> region-code: "";
    in property <string> strategy-text: "—";
    in property <string> ping-text: "—";
    in property <string> up-text: "0 КБ/с";
    in property <string> down-text: "0 КБ/с";
    in property <[RegionRow]> regions;
    in property <[RuleRow]> rules;
    in property <[string]> log-lines;
    in property <string> preset-name: "smart_ru";
    in-out property <bool> system-proxy: true;

    in-out property <string> search-text: "";
    in-out property <string> test-text: "";
    in property <string> test-result: "";
    in-out property <string> add-domain: "";
    in-out property <int> add-action-index: 3;
    in-out property <string> vless-uri: "";
    in-out property <string> psi-channel: "";
    in-out property <string> psi-sponsor: "";
    in-out property <string> psi-url: "";
    in-out property <string> psi-key: "";

    callback toggle-connect();
    callback pick-region(string);
    callback toggle-fav(string);
    callback set-preset(string);
    callback run-test();
    callback add-rule();
    callback delete-rule(int);
    callback import-vless();
    callback save-psiphon();
    callback register-warp();
    callback scan-ips();
    callback scan-warp();
    callback autotune();
    callback sysproxy-changed(bool);
    callback search-edited();
    callback quit-app();
}

// Тёмное поле ввода (родные LineEdit в светлой теме Windows выглядят чужеродно).
component DarkField inherits Rectangle {
    in-out property <string> text <=> input.text;
    in property <string> placeholder: "";
    callback edited();
    callback accepted();
    height: 40px;
    border-radius: 10px;
    background: #1b1b2e;
    border-width: input.has-focus ? 1px : 0px;
    border-color: #7C5CFF;
    clip: true;

    Text {
        x: 12px;
        width: parent.width - 24px;
        height: 100%;
        text: root.placeholder;
        color: #66668a;
        font-size: 14px;
        vertical-alignment: center;
        visible: input.text == "";
    }
    input := TextInput {
        x: 12px;
        width: parent.width - 24px;
        height: 100%;
        color: white;
        font-size: 14px;
        single-line: true;
        vertical-alignment: center;
        edited => { root.edited(); }
        accepted => { root.accepted(); }
    }
}

// Тёмный выпадающий список действий.
component DarkCombo inherits Rectangle {
    in property <[string]> model;
    in-out property <int> current-index: 0;
    callback changed();
    height: 40px;
    width: 118px;
    border-radius: 10px;
    background: #1b1b2e;
    clip: false;

    Text {
        x: 12px;
        width: parent.width - 36px;
        height: 100%;
        text: root.model[root.current-index];
        color: white;
        font-size: 14px;
        vertical-alignment: center;
    }
    Text {
        x: parent.width - 26px;
        width: 16px;
        height: 100%;
        text: "▾";
        color: #a7a7c7;
        font-size: 14px;
        vertical-alignment: center;
    }
    TouchArea { clicked => { popup.show(); } }

    popup := PopupWindow {
        x: 0px;
        y: 44px;
        width: root.width;
        VerticalLayout {
            spacing: 2px;
            padding: 4px;
            for option[idx] in root.model: Rectangle {
                height: 34px;
                border-radius: 8px;
                background: idx == root.current-index ? #7C5CFF : #23233a;
                Text {
                    x: 10px;
                    text: option;
                    color: white;
                    font-size: 13px;
                    vertical-alignment: center;
                }
                TouchArea {
                    clicked => {
                        root.current-index = idx;
                        root.changed();
                        popup.close();
                    }
                }
            }
        }
    }
}


// Тёмный переключатель (родной CheckBox берёт цвет текста из светлой палитры).
component ToggleRow inherits Rectangle {
    in property <string> text;
    in-out property <bool> checked;
    callback toggled(bool);
    height: 40px;
    HorizontalLayout {
        spacing: 10px;
        Text {
            text: root.text;
            color: white;
            font-size: 14px;
            vertical-alignment: center;
            horizontal-stretch: 1;
        }
        Rectangle {
            width: 46px; height: 26px; y: 7px;
            border-radius: 13px;
            background: root.checked ? #7C5CFF : #2c2c4a;
            Rectangle {
                width: 20px; height: 20px; y: 3px;
                x: root.checked ? 23px : 3px;
                border-radius: 10px;
                background: white;
            }
        }
    }
    TouchArea {
        clicked => {
            root.checked = !root.checked;
            root.toggled(root.checked);
        }
    }
}

component NavButton inherits Rectangle {
    in property <string> text;
    in property <bool> active;
    callback tapped();
    height: 44px;
    border-radius: 12px;
    background: active ? #7C5CFF : #1b1b2e;
    Text {
        text: root.text;
        color: white;
        font-size: 13px;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
    TouchArea { clicked => { root.tapped(); } }
}

component ActionButton inherits Rectangle {
    in property <string> text;
    in property <bool> accent: false;
    callback tapped();
    height: 40px;
    border-radius: 12px;
    background: accent ? #7C5CFF : #23233a;
    Text {
        text: root.text;
        color: white;
        font-size: 14px;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
    TouchArea { clicked => { root.tapped(); } }
}

component SectionTitle inherits Text {
    color: #a7a7c7;
    font-size: 13px;
}

export component Tray inherits SystemTrayIcon {
    in property <bool> connected;
    in property <bool> busy;
    in property <image> icon-off;
    in property <image> icon-on;
    in property <image> icon-busy;
    icon: busy ? icon-busy : connected ? icon-on : icon-off;
    tooltip: "PsiRoute";
    title: "PsiRoute";
    callback show-window();
    callback toggle();
    callback quit();
    clicked => { root.show-window(); }
    Menu {
        MenuItem {
            title: "Открыть PsiRoute";
            activated => { root.show-window(); }
        }
        MenuItem {
            title: root.connected || root.busy ? "Отключить" : "Подключить";
            activated => { root.toggle(); }
        }
        MenuSeparator { }
        MenuItem {
            title: "Выход";
            activated => { root.quit(); }
        }
    }
}

export component MainWindow inherits Window {
    title: "PsiRoute";
    width: 400px;
    height: 700px;
    background: #0d0d17;
    in property <image> app-icon;
    icon: app-icon;

    VerticalLayout {
        padding: 16px;
        spacing: 12px;

        // ---------- шапка ----------
        HorizontalLayout {
            height: 28px;
            spacing: 8px;
            Rectangle {
                width: 14px; height: 14px; y: 7px;
                border-radius: 7px;
                background: #7C5CFF;
            }
            Text {
                text: "PsiRoute";
                color: white;
                font-size: 17px;
                font-weight: 700;
                vertical-alignment: center;
            }
            Rectangle { horizontal-stretch: 1; }
            Rectangle {
                width: 10px; height: 10px; y: 9px;
                border-radius: 5px;
                background: Logic.connected ? #3ddc84 : (Logic.connecting ? #ffb340 : #55556e);
            }
            Text {
                text: Logic.status-text;
                color: #a7a7c7;
                font-size: 12px;
                vertical-alignment: center;
            }
        }

        // ---------- страницы ----------
        Rectangle {
            vertical-stretch: 1;
            background: transparent;

            // Главный экран
            if Logic.page == 0: VerticalLayout {
                alignment: start;
                spacing: 14px;
                padding-top: 18px;

                Rectangle {
                    width: 204px;
                    height: 204px;
                    x: (parent.width - self.width) / 2;
                    border-radius: 102px;
                    background: #12121f;
                    border-width: 4px;
                    border-color: Logic.connected ? #00D1FF : (Logic.connecting ? #ffb340 : #2c2c4a);
                    Rectangle {
                        width: 176px;
                        height: 176px;
                        x: 14px;
                        y: 14px;
                        border-radius: 88px;
                        background: #12121f;
                        Text {
                            text: Logic.connecting ? "Подключаю…" : (Logic.connected ? "Отключить" : "Подключить");
                            color: white;
                            font-size: 19px;
                            font-weight: 700;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                    }
                    TouchArea { clicked => { Logic.toggle-connect(); } }
                }

                Text {
                    text: Logic.connected ? "Выход: " + Logic.strategy-text : "Нажмите «Подключить» — выход подберётся сам: Psiphon, VLESS, WARP или фрагментация DPI";
                    color: #8a8ab0;
                    font-size: 12px;
                    horizontal-alignment: center;
                    wrap: word-wrap;
                }

                ActionButton {
                    text: Logic.region-label;
                    tapped => { Logic.page = 1; }
                }

                HorizontalLayout {
                    spacing: 8px;
                    Rectangle {
                        border-radius: 12px; background: #171728; height: 56px;
                        Text { text: "Стратегия\n" + Logic.strategy-text; color: #a7a7c7; font-size: 12px; horizontal-alignment: center; vertical-alignment: center; }
                    }
                    Rectangle {
                        border-radius: 12px; background: #171728; height: 56px;
                        Text { text: "Пинг\n" + Logic.ping-text; color: #a7a7c7; font-size: 12px; horizontal-alignment: center; vertical-alignment: center; }
                    }
                }
                HorizontalLayout {
                    spacing: 8px;
                    Rectangle {
                        border-radius: 12px; background: #171728; height: 56px;
                        Text { text: "↑ " + Logic.up-text; color: #8be9c9; font-size: 14px; horizontal-alignment: center; vertical-alignment: center; }
                    }
                    Rectangle {
                        border-radius: 12px; background: #171728; height: 56px;
                        Text { text: "↓ " + Logic.down-text; color: #8ec9e9; font-size: 14px; horizontal-alignment: center; vertical-alignment: center; }
                    }
                }
            }

            // Страны
            if Logic.page == 1: VerticalLayout {
                spacing: 10px;
                DarkField {
                    text <=> Logic.search-text;
                    placeholder: "Поиск страны…";
                    edited => { Logic.search-edited(); }
                }
                ListView {
                    vertical-stretch: 1;
                    for region in Logic.regions: Rectangle {
                        height: 54px;
                        background: transparent;
                        Rectangle {
                            y: 4px;
                            width: parent.width - 12px;
                            height: 46px;
                            border-radius: 10px;
                            background: Logic.region-code == region.code ? #2c2350 : #171728;
                            HorizontalLayout {
                                padding-left: 10px; padding-right: 8px; spacing: 10px;
                                Rectangle {
                                    width: 34px; height: 34px; y: 6px;
                                    border-radius: 17px;
                                    background: #7C5CFF;
                                    Text { text: region.code; color: white; font-size: 11px; font-weight: 700; horizontal-alignment: center; vertical-alignment: center; }
                                }
                                Text {
                                    text: region.label;
                                    color: white; font-size: 15px;
                                    vertical-alignment: center;
                                    horizontal-stretch: 1;
                                }
                                Rectangle {
                                    width: 36px;
                                    Text { text: region.fav ? "★" : "☆"; color: #ffd34d; font-size: 18px; horizontal-alignment: center; vertical-alignment: center; }
                                    TouchArea { clicked => { Logic.toggle-fav(region.code); } }
                                }
                            }
                            TouchArea { clicked => { Logic.pick-region(region.code); } }
                        }
                    }
                }
                ActionButton { text: "Лучшая (авто)"; accent: Logic.region-code == ""; tapped => { Logic.pick-region(""); } }
            }

            // Маршруты
            if Logic.page == 2: VerticalLayout {
                spacing: 10px;
                alignment: start;
                SectionTitle { text: "Пресет"; }
                HorizontalLayout {
                    spacing: 8px;
                    NavButton { text: "Умный РФ"; active: Logic.preset-name == "smart_ru"; tapped => { Logic.set-preset("smart_ru"); } }
                    NavButton { text: "Только заблок."; active: Logic.preset-name == "blocked_only"; tapped => { Logic.set-preset("blocked_only"); } }
                    NavButton { text: "Всё через VPN"; active: Logic.preset-name == "all_vpn"; tapped => { Logic.set-preset("all_vpn"); } }
                }
                SectionTitle { text: "Свои правила (выше пресетов)"; }
                if Logic.rules.length == 0: Text {
                    text: "Своих правил пока нет — добавьте ниже.";
                    color: #66668a;
                    font-size: 13px;
                }
                if Logic.rules.length > 0: ListView {
                    height: min(184px, Logic.rules.length * 46px);
                    for rule[idx] in Logic.rules: Rectangle {
                        height: 46px;
                        background: transparent;
                        Rectangle {
                            y: 3px;
                            height: 40px;
                            border-radius: 10px;
                            background: #171728;
                            HorizontalLayout {
                                padding-left: 10px; padding-right: 6px; spacing: 6px;
                                Text { text: rule.target + " → " + rule.action; color: white; font-size: 13px; vertical-alignment: center; horizontal-stretch: 1; }
                                Rectangle {
                                    width: 32px;
                                    Text { text: "✕"; color: #ff7b7b; font-size: 14px; horizontal-alignment: center; vertical-alignment: center; }
                                    TouchArea { clicked => { Logic.delete-rule(idx); } }
                                }
                            }
                        }
                    }
                }
                HorizontalLayout {
                    spacing: 8px;
                    DarkField { text <=> Logic.add-domain; placeholder: "домен, напр. youtube.com"; horizontal-stretch: 1; }
                    DarkCombo {
                        model: ["direct", "dpi", "vless", "psiphon", "warp", "block"];
                        current-index <=> Logic.add-action-index;
                    }
                }
                ActionButton { text: "Добавить правило"; tapped => { Logic.add-rule(); } }
                Rectangle { height: 1px; background: #2a2a44; }
                SectionTitle { text: "Куда пойдёт:"; }
                DarkField { text <=> Logic.test-text; placeholder: "домен для проверки"; accepted => { Logic.run-test(); } }
                ActionButton { text: "Проверить"; tapped => { Logic.run-test(); } }
                Text { text: Logic.test-result; color: #8be9c9; font-size: 13px; }
            }

            // Лента
            if Logic.page == 3: VerticalLayout {
                spacing: 8px;
                SectionTitle { text: "События и соединения"; }
                if Logic.log-lines.length == 0: Text {
                    text: "Пока пусто. События подключения и маршруты соединений появятся здесь.";
                    color: #66668a;
                    font-size: 13px;
                    wrap: word-wrap;
                }
                ListView {
                    vertical-stretch: 1;
                    for line in Logic.log-lines: Text {
                        text: line;
                        color: #c9c9e0;
                        font-size: 12px;
                        wrap: word-wrap;
                    }
                }
            }

            // Настройки
            if Logic.page == 4: ScrollView {
                VerticalLayout {
                    spacing: 10px;
                    alignment: start;
                    padding-right: 8px;
                    ToggleRow {
                        text: "Системный прокси при подключении";
                        checked <=> Logic.system-proxy;
                        toggled => { Logic.sysproxy-changed(Logic.system-proxy); }
                    }
                    Text { text: "TUN-режим: шаг 08, в этой сборке недоступен"; color: #77779a; font-size: 12px; }
                    Rectangle { height: 1px; background: #2a2a44; }
                    Text { text: "Импорт VLESS (свой Worker)"; color: white; font-size: 14px; }
                    DarkField { text <=> Logic.vless-uri; placeholder: "vless://…"; }
                    ActionButton { text: "Импортировать"; tapped => { Logic.import-vless(); } }
                    HorizontalLayout {
                        spacing: 8px;
                        ActionButton { text: "Сканер чистых IP"; tapped => { Logic.scan-ips(); } }
                        ActionButton { text: "Автоподбор DPI"; tapped => { Logic.autotune(); } }
                    }
                    Rectangle { height: 1px; background: #2a2a44; }
                    Text { text: "WARP"; color: white; font-size: 14px; }
                    HorizontalLayout {
                        spacing: 8px;
                        ActionButton { text: "Зарегистрировать"; tapped => { Logic.register-warp(); } }
                        ActionButton { text: "Сканер эндпоинтов"; tapped => { Logic.scan-warp(); } }
                    }
                    Rectangle { height: 1px; background: #2a2a44; }
                    Text { text: "Сеть Psiphon (секреты уйдут в config.local.toml)"; color: white; font-size: 14px; }
                    DarkField { text <=> Logic.psi-channel; placeholder: "PropagationChannelId"; }
                    DarkField { text <=> Logic.psi-sponsor; placeholder: "SponsorId"; }
                    DarkField { text <=> Logic.psi-url; placeholder: "RemoteServerListUrl"; }
                    DarkField { text <=> Logic.psi-key; placeholder: "RemoteServerListSignaturePublicKey"; }
                    ActionButton { text: "Сохранить параметры Psiphon"; tapped => { Logic.save-psiphon(); } }
                }
            }
        }

        // ---------- нижняя навигация ----------
        HorizontalLayout {
            spacing: 8px;
            NavButton { text: "Главная"; active: Logic.page == 0; tapped => { Logic.page = 0; } }
            NavButton { text: "Страны"; active: Logic.page == 1; tapped => { Logic.page = 1; } }
            NavButton { text: "Маршруты"; active: Logic.page == 2; tapped => { Logic.page = 2; } }
            NavButton { text: "Лента"; active: Logic.page == 3; tapped => { Logic.page = 3; } }
            NavButton { text: "Настройки"; active: Logic.page == 4; tapped => { Logic.page = 4; } }
        }
    }
}
